    },
    {
      "title": "Сумма подозрительных платежей по категориям",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT cat_id AS \"Категория\", count(*) AS \"Транзакций\", sum(amount) AS \"Сумма\", sum(amount) FILTER (WHERE fraud_flag = 1) AS \"Подозрительная сумма\", avg(score) AS \"Средний скор\" FROM scores WHERE $__timeFilter(created_at) AND us_state IN (${us_state:sqlstring}) AND merch IN (${merch:sqlstring}) GROUP BY cat_id ORDER BY 4 DESC NULLS LAST",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
