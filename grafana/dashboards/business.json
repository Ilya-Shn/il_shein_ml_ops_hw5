  "panels": [
    {
      "title": "Плотность распределения скоров",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "WITH bins AS (SELECT generate_series(0,19) AS bin),\n    selected AS (SELECT least(floor(score * 20)::int,19) AS bin FROM scores WHERE $__timeFilter(created_at) AND us_state IN (${us_state:sqlstring}) AND merch IN (${merch:sqlstring})),\n    counts AS (SELECT bin, count(*) AS n FROM selected GROUP BY bin)\n    SELECT to_char(bins.bin * 0.05, '0.00') || '–' || to_char((bins.bin + 1) * 0.05, '0.00') AS score,\n    coalesce(n,0)::float / greatest((SELECT count(*) FROM selected),1) / 0.05 AS \"Плотность\"\n    FROM bins LEFT JOIN counts USING (bin) ORDER BY bins.bin",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "xField": "score",
        "orientation": "vertical",
        "showValue": "auto",
        "xTickLabelRotation": -45
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "TPS выбранных транзакций",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT $__timeGroup(created_at,'5s') AS time, count(*) / 5.0 AS \"TPS\" FROM scores WHERE $__timeFilter(created_at) AND us_state IN (${us_state:sqlstring}) AND merch IN (${merch:sqlstring}) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
