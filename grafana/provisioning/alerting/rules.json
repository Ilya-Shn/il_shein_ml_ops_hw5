{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "Мониторинг потока",
      "folder": "HW5",
      "interval": "10s",
      "rules": [
        {
          "uid": "flow-stopped",
          "title": "Поток транзакций остановился",
          "condition": "B",
          "for": "30s",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "annotations": {
            "summary": "Нет обработанных транзакций более 30 секунд",
            "__dashboardUid__": "scoring",
            "__panelId__": "1"
          },
          "labels": {
            "project": "HW5"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "rate(scorer_transactions_total[30s]) == bool 0",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "fraud-high",
          "title": "Высокая доля фрода",
          "condition": "B",
          "for": "30s",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "annotations": {
            "summary": "Доля фрода за 30 секунд выше 10%",
            "__dashboardUid__": "scoring",
            "__panelId__": "3"
          },
          "labels": {
            "project": "HW5"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "(rate(scorer_fraud_total[30s]) / clamp_min(rate(scorer_transactions_total[30s]), 0.000001)) > bool 0.1",
                "instant": true,
                "range": false,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "B"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
